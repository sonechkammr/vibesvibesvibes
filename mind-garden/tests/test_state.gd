extends SceneTree

const Model = preload("res://scripts/garden_state.gd")
var checks: int = 0
var failures: int = 0

func check(condition: bool, description: String) -> void:
	checks += 1
	if not condition:
		failures += 1
		push_error("FAIL: " + description)

func _initialize() -> void:
	var state := Model.new("user://state_test.json")
	state.fresh(1000000)
	check(state.data.plants.size() == 3, "A fresh garden has three plants")
	check(state.valid(state.data), "Initial schema is valid")
	var start_age: float = state.data.world_age
	state.advance(1000000 + 86400)
	check(is_equal_approx(state.data.world_age, start_age + 86400), "One day passes offline")
	state.advance(1000000 + 86400)
	check(is_equal_approx(state.data.world_age, start_age + 86400), "Reopening is idempotent")
	state.advance(1000000 - 100)
	check(is_equal_approx(state.data.world_age, start_age + 86400), "Clock rollback never de-ages the garden")
	state.advance(1000000 + 86400)
	check(is_equal_approx(state.data.world_age, start_age + 86400), "Clock recovery never double-counts elapsed time")
	state.advance(1000000 + 86400 * 9)
	var seeds: int = state.data.seeds
	check(seeds > 0, "Flowers leave seeds over time")
	state.advance(1000000 + 86400 * 9)
	check(state.data.seeds == seeds, "Reopening never grants duplicate seeds")
	check(state.data.plants.size() == 3, "Absence never removes plants")
	var now: int = 1000000 + 86400 * 9
	var sad_id: int = state.add_event("mood", "Трудный день", ["Грусть"], 4, 0, now)
	check(state.atmosphere() == "rain", "Sadness changes atmosphere")
	check(state.data.plants.size() == 3, "Sadness never damages or removes a plant")
	state.advance(now + 21601)
	check(state.atmosphere() == "clear", "Mood atmosphere expires without another check-in")
	state.remove_event(sad_id)
	var deed_id: int = state.add_event("deed", "Помогли другу", ["Помогли"], 1, 0, now + 21601)
	check(state.data.plants.size() == 4, "A deed leaves a visible plant")
	check(state.valid(state.data), "New events keep a valid schema")
	state.remove_event(deed_id)
	check(state.data.plants.size() == 3, "Deleting a mistaken deed removes only its own plant")
	var practice_id: int = state.add_event("practice", "Практика", [], 1, 180, now + 21601)
	check(state.practice_seconds() == 180, "Meditation duration is recorded")
	state.remove_event(practice_id)
	check(state.practice_seconds() == 0, "Deleting a practice recalculates its trace")
	check(state.save() == OK, "Atomic save succeeds")
	var restored := Model.new("user://state_test.json")
	check(restored.load_or_create(now + 21601), "Save loads")
	check(JSON.stringify(restored.data) == JSON.stringify(state.data), "Round-trip preserves serialized values")
	check(state.save() == OK, "Second save creates a backup")
	var broken := FileAccess.open("user://state_test.json", FileAccess.WRITE)
	broken.store_string("{not valid json")
	broken.close()
	var recovered := Model.new("user://state_test.json")
	check(recovered.load_or_create(now + 21601), "Backup recovers a damaged primary")
	check(recovered.recovered_backup, "Backup recovery is reported")
	check(recovered.save() == OK, "Recovered data can be saved")
	var many := Model.new()
	many.fresh(now)
	for i in range(40):
		many.add_event("deed", "Дело", [], 1, 0, now)
	check(many.data.plants.size() == Model.SLOTS.size(), "A full garden does not stack infinite sprites")
	check(many.data.events.size() == 40, "A full garden retains every journal entry")
	check(not state.valid({"version": 99}), "Unknown format is rejected")
	var malformed: Dictionary = state.data.duplicate(true)
	malformed.events.append({"id": "bad"})
	check(not state.valid(malformed), "Malformed imported entries are rejected")
	var combined := Model.new("user://combined_test.json")
	combined.fresh(now)
	var combined_id: int = combined.add_entry({"Тревога":37,"Благодарность":82},["Помогли"],"Одна запись",now)
	check(combined.data.events.size()==1,"States and deeds share one entry")
	check(combined.data.events[0].states["Тревога"]==37 and combined.data.events[0].states["Благодарность"]==82,"Independent percentages are preserved")
	check(combined.atmosphere()=="wind","Combined states affect atmosphere")
	check(is_equal_approx(float(combined.atmosphere_detail().strength),0.37),"Weather strength follows intensity")
	combined.edit_entry(combined_id,{"Грусть":0},[],"Правка")
	check(combined.data.events.size()==1 and combined.data.plants.size()==4,"Editing does not duplicate entry or plant")
	check(combined.atmosphere()=="clear","Explicit zero intensity creates no weather")
	combined.edit_entry(combined_id,{"Грусть":90},[],"Правка 2")
	check(is_equal_approx(float(combined.atmosphere_detail().strength),0.9),"Changed percentage updates weather")
	combined.data.draft = {"states":{"Радость":64},"deeds":["Помогли"],"note":"Черновик"}
	combined.save()
	var combined_reload := Model.new(combined.path)
	check(combined_reload.load_or_create(now),"Combined state loads")
	check(combined_reload.data.draft.note=="Черновик" and combined_reload.data.draft.states["Радость"]==64,"Draft survives restart")
	var legacy := {"version":1,"born_at":now,"last_tick":now,"world_age":0.0,"next_id":2,"seed":17,"seeds":4,"sound":false,"intro_seen":true,"events":[{"id":1,"kind":"mood","note":"Старая запись","emotions":["Грусть","Радость"],"intensity":3,"duration":0,"created_at":now,"created_age":0.0}],"plants":[{"id":"initial_0","event_id":0,"slot":0,"born_age":0.0,"cycles":0}]}
	var legacy_file := FileAccess.open("user://migration_test.json",FileAccess.WRITE)
	legacy_file.store_string(JSON.stringify(legacy))
	legacy_file.close()
	var migrated := Model.new("user://migration_test.json")
	check(migrated.load_or_create(now),"Version 1 file migrates")
	check(migrated.data.version==2 and migrated.data.seeds==4 and not migrated.data.sound,"Migration preserves garden and settings")
	check(migrated.data.events[0].legacy_intensity==3 and migrated.data.events[0].states["Грусть"]==60,"Legacy shared scale remains identified")
	check(FileAccess.file_exists(migrated.path+".v1"),"Migration preserves original v1 file")
	check(migrated.save()==OK,"Migrated file writes atomically")
	var migrated_again := Model.new(migrated.path)
	check(migrated_again.load_or_create(now) and migrated_again.data.events.size()==1,"Migration is not repeated or duplicated")
	var full := Model.new()
	full.fresh(now)
	for i in range(80):
		full.add_entry({},["Помогли"],"",now)
	check(full.data.plants.size()==Model.SLOTS.size(),"New garden fills only defined slots")
	check(full.data.seeds>0 and full.data.events.size()==80,"Full garden retains entries and leaves seeds")
	check(full.valid(full.data),"Land and aquatic species match their habitat")
	var arrangement: String = JSON.stringify(full.data.plants)
	full.advance(now)
	check(JSON.stringify(full.data.plants)==arrangement,"Re-entry does not rearrange plants")
	for i in range(500):
		full.pattern("transitions",8)
	check(full.data.traces.size()<=48,"Interaction traces stay bounded")
	check(full.data.patterns.transitions==4000,"Aggregate usage is retained locally")
	var invalid_percent: Dictionary = full.data.duplicate(true)
	invalid_percent.events[0].states = {"Грусть":101}
	check(not full.valid(invalid_percent),"Out-of-range emotion is rejected")
	print("STATE %s: %d checks, %d failures" % ["PASS" if failures == 0 else "FAIL", checks, failures])
	quit(0 if failures == 0 else 1)
